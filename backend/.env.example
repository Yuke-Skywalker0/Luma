NODE_ENV=development
PORT=8787
APP_VERSION=6.9.0
# Leave empty when frontend and API are served by the same Render URL.
FRONTEND_ORIGIN=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

AUDIUS_API_KEY=
AUDIUS_API_BASE=https://discoveryprovider.audius.co/v1

JAMENDO_CLIENT_ID=
JAMENDO_API_BASE=https://api.jamendo.com/v3.0

SOUNDCLOUD_CLIENT_ID=

MUSICBRAINZ_USER_AGENT=LumaMusic/6.9.0 (https://your-render-service.onrender.com; your-email@example.com)

# V7 Google authentication / profile
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=luma
